USE_SQLITE=true
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false

# Postgres (used when USE_SQLITE=false, including Docker Compose)
POSTGRES_DB=assets
POSTGRES_USER=assets
POSTGRES_PASSWORD=assets
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Mail: with DJANGO_DEBUG=true and EMAIL_HOST empty, messages print in the terminal.
# Set EMAIL_HOST to send password resets and stock alerts through SMTP.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Asset Control <no-reply@example.com>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Login lockout (failed attempts per username and per IP)
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_SECONDS=900
LOGIN_FAILURE_WINDOW_SECONDS=900
# Only set true behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
OTP_ISSUER=Asset Control
